# ==============================================================================
# TRUTHLENS AI — Comprehensive Environment Configuration Template (Part 15)
# ==============================================================================
# IMPORTANT:
# 1. Copy this template to .env before starting the application: cp .env.example .env
# 2. NEVER commit actual production secrets, tokens, or private keys to version control.
# 3. For local evaluation & demo, all defaults operate out-of-the-box (zero credentials required).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Server Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="TruthLens AI"
ENVIRONMENT="development"                # Options: "development", "staging", "production"
DEBUG=True                              # Set to False in production
API_V1_PREFIX="/api"
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Configuration & Migrations
# ------------------------------------------------------------------------------
# Local SQLite Dev Default (zero configuration needed):
DATABASE_URL="sqlite:///./truthlens_dev.db"

# Production PostgreSQL Example (uncomment for production deployment):
# DATABASE_URL="postgresql://truthlens_user:secure_password_here@localhost:5432/truthlens_db"

# ------------------------------------------------------------------------------
# 3. Security, Encryption & CORS
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace_with_a_secure_random_32_byte_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000"]

# ------------------------------------------------------------------------------
# 4. Storage & Filesystem Settings
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="local"
STORAGE_PATH="./storage/media"
KEYFRAME_STORAGE_PATH="./storage/media/frames"
REPORTS_STORAGE_PATH="./storage/reports"
STORAGE_BUCKET="truthlens-media-dev"
MAX_UPLOAD_SIZE_BYTES=52428800           # 50 MB generic ceiling

# Modality-Specific File Upload Ceilings
MAX_IMAGE_FILE_SIZE_BYTES=15728640      # 15 MB
MAX_IMAGE_PIXELS=25000000               # 25 MP (decompression bomb protection)
MAX_IMAGE_DIMENSION=6000                # Max width/height dimension in pixels
MAX_AUDIO_SIZE_BYTES=52428800           # 50 MB
MAX_VIDEO_SIZE_BYTES=209715200          # 200 MB
MAX_AUDIO_DURATION_SECONDS=600          # 10 minutes maximum duration
MAX_VIDEO_DURATION_SECONDS=600          # 10 minutes maximum duration

# ------------------------------------------------------------------------------
# 5. Search Engine Configuration (Part 4)
# ------------------------------------------------------------------------------
# Provider Options: "duckduckgo", "tavily", "google", "serpapi", "brave", "mock", "none"
# Default: "duckduckgo" (works without API key)
SEARCH_PROVIDER="duckduckgo"
SEARCH_API_KEY=""                       # Required if using Tavily, SerpApi, or Brave
SEARCH_ENGINE_ID=""                     # Required if using Google Custom Search (cx parameter)
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 6. LLM Claim & Reasoning Services (Optional Fallback / Enhancement)
# ------------------------------------------------------------------------------
# Provider Options: "openai", "gemini", "anthropic", "ollama", "none"
# Default rule-based NLP claim extractor operates with zero external API keys.
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""                          # Leave blank for built-in rule-based NLP
LLM_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 7. OCR & Vision Settings (Part 8)
# ------------------------------------------------------------------------------
# Path to Tesseract binary if not in system PATH (e.g., "C:\\Program Files\\Tesseract-OCR\\tesseract.exe")
TESSERACT_CMD=""
OCR_CONFIDENCE_THRESHOLD=30.0           # Minimum word confidence score (0-100)

# ------------------------------------------------------------------------------
# 8. Speech Transcription Settings (Part 9)
# ------------------------------------------------------------------------------
# Provider Options: "auto", "whisper_local", "whisper_api", "fallback"
# Default: "auto" (falls back gracefully to embedded transcription engine if Whisper uninstalled)
TRANSCRIPTION_PROVIDER="auto"
TRANSCRIPTION_CONFIDENCE_THRESHOLD=0.40

# ------------------------------------------------------------------------------
# 9. Video & Multimedia Analysis Settings (Part 10)
# ------------------------------------------------------------------------------
FRAME_INTERVAL_SECONDS=5.0              # Sample keyframes every N seconds
MAX_ANALYZED_FRAMES=15                  # Maximum keyframes extracted per video
MAX_FRAME_ANALYSIS_TIME_SECONDS=30.0    # Timeout budget for video decomposition
SCENE_CHANGE_THRESHOLD=0.35             # Normalized histogram delta for scene changes
MAX_ANALYSIS_FRAME_WIDTH=1280

# ------------------------------------------------------------------------------
# 10. News Article Web Scraping & SSRF Defense (Part 7 & 14)
# ------------------------------------------------------------------------------
MAX_ARTICLE_RESPONSE_MB=5               # Maximum HTML response size
ARTICLE_REQUEST_TIMEOUT_SECONDS=15      # Overall HTTP download timeout
ARTICLE_CONNECT_TIMEOUT_SECONDS=5       # Socket connection timeout
MAX_ARTICLE_REDIRECTS=5                 # Maximum per-hop redirect follows
